  function translateValue(value) {
    if (!value || !JP.test(value)) return value;

    const trimmed = value.trim();

    if (EXACT.has(trimmed)) {
      const translated = EXACT.get(trimmed);
      return value.replace(trimmed, translated);
    }

    for (const [re, replacement] of DYNAMIC) {
      if (re.test(trimmed)) {
        return value.replace(trimmed, trimmed.replace(re, replacement));
      }
    }

    if (FRAGMENTS.has(trimmed)) {
      return value.replace(trimmed, FRAGMENTS.get(trimmed));
    }

    return value;
  }

  function translateNode(node) {
    if (!node) return;

    if (node.nodeType === Node.TEXT_NODE) {
      const oldValue = node.nodeValue;
      const newValue = translateValue(oldValue);
      if (newValue !== oldValue) node.nodeValue = newValue;
      return;
    }

    if (node.nodeType !== Node.ELEMENT_NODE &&
        node.nodeType !== Node.DOCUMENT_FRAGMENT_NODE &&
        node.nodeType !== Node.DOCUMENT_NODE) return;

    if (node.nodeType === Node.ELEMENT_NODE &&
        ['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(node.tagName)) return;

    if (node.nodeType === Node.ELEMENT_NODE) {
      ['title', 'aria-label', 'placeholder', 'alt', 'value'].forEach(attr => {
        if (!node.hasAttribute?.(attr)) return;
        const oldValue = node.getAttribute(attr);
        const newValue = translateValue(oldValue);
        if (newValue !== oldValue) node.setAttribute(attr, newValue);
      });

      [...node.childNodes].forEach(child => {
        if (child.nodeType === Node.TEXT_NODE) translateNode(child);
      });
    }

    node.querySelectorAll?.('*').forEach(el => {
      if (['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(el.tagName)) return;

      [...el.childNodes].forEach(child => {
        if (child.nodeType === Node.TEXT_NODE) translateNode(child);
      });

      ['title', 'aria-label', 'placeholder', 'alt', 'value'].forEach(attr => {
        if (!el.hasAttribute?.(attr)) return;
        const oldValue = el.getAttribute(attr);
        const newValue = translateValue(oldValue);
        if (newValue !== oldValue) el.setAttribute(attr, newValue);
      });
    });
  }

  function scan() {
    translateNode(document);
  }

  const observer = new MutationObserver(records => {
    for (const record of records) {
      if (record.type === 'characterData') {
        translateNode(record.target);
        continue;
      }

      record.addedNodes.forEach(translateNode);

      if (record.type === 'attributes') {
        translateNode(record.target);
      }
    }
  });

  function start() {
    scan();

    observer.observe(document.documentElement, {
      subtree: true,
      childList: true,
      characterData: true,
      attributes: true,
      attributeFilter: ['title', 'aria-label', 'placeholder', 'alt', 'value']
    });

    /* Backup sweep for plugin screens that rebuild their DOM. */
    setInterval(scan, 750);

    console.log(`[KW Mail Assist English Patch] Version ${VERSION} loaded`);
  }

  if (document.readyState === 'loading') {
